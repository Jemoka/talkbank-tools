"""batchalign-core — types and traits for the batchalign rewrite (spec2.md).

Pure-Rust crate (no tokio, no sqlite). PyO3 #[pyclass] bindings are gated
behind the `python` cargo feature; `batchalign-engine` enables that feature
when compiling its #[pymodule].

External deps flow through `crate_universe`'s `all_crate_deps()`; intra-
workspace links are listed explicitly per MEMORY.md.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_INTRA = [
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/core/talkbank-transform:talkbank_transform",
]

# `srcs` excludes `src/bin/**` so the library compile doesn't double-count
# the binary entry points. The schema emitter is built as its own
# `rust_binary` below.
rust_library(
    name = "batchalign_core",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    aliases = aliases(),
    crate_features = ["python"],
    crate_name = "batchalign_core",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + _INTRA,
    # Bake the workspace SHA in via rules_rust stamping (sourced from
    # `bazel/stamp.sh` → stable-status.txt). build.rs sets the same env
    # var on the Cargo path; the two converge at compile time so
    # `option_env!("VERGEN_GIT_SHA")` resolves under both build systems.
    # Consumed by `taskrunners::asr` to stamp `@Comment: batchalign3 <sha>
    # | engine: …` onto generated CHAT files.
    rustc_env = {
        "VERGEN_GIT_SHA": "{STABLE_GIT_HASH}",
    },
    stamp = 1,
)

# Schema emitter binary. Consumed by `:proto_schema_json` below as the input
# to the Python codegen pipeline. The set of emitted types is hand-listed in
# `src/bin/emit_proto_schema.rs`; adding a Rust proto type means also adding
# it there.
rust_binary(
    name = "emit_proto_schema",
    srcs = ["src/bin/emit_proto_schema.rs"],
    aliases = aliases(),
    crate_features = ["python"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + _INTRA + [":batchalign_core"],
)

# `proto.schema.json` — the unified JSON Schema for every wire type.
# Regenerated on any change to the schema emitter source or to its
# transitive Rust deps (i.e. any proto file). Consumed by the Python
# codegen genrule at `//python/batchalign/_core:_proto_generated`.
genrule(
    name = "proto_schema_json",
    outs = ["proto.schema.json"],
    cmd = "$(execpath :emit_proto_schema) $@",
    tools = [":emit_proto_schema"],
)

rust_test(
    name = "batchalign_core_unit_test",
    crate = ":batchalign_core",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

# proto_parity.rs spawns a python3 subprocess that imports batchalign._core.proto
# and probes for class existence. It is skip-tolerant: if the wheel hasn't been
# built (no `maturin develop` yet), the test prints SKIP and passes — that's the
# spec §18.2 design. Run via: `bazel test //crates/batchalign/batchalign-core:proto_parity`.
rust_test(
    name = "proto_parity",
    srcs = ["tests/proto_parity.rs"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    # `inventory` is a regular dep on batchalign-core (used by the
    # link-time proto registry). The test enumerates registered types so
    # it needs to depend on inventory directly, not just transitively.
    deps = all_crate_deps(normal_dev = True) + all_crate_deps(normal = True) +
        _INTRA + [":batchalign_core"],
)

# Each of the four spec2.md goal scenarios — ASR, UtSeg, Compare,
# Morphosyntax with-and-without retokenize — is exercised by unit tests
# inside the corresponding `runners/<task>.rs` module, run as part of
# `batchalign_core_unit_test` above. See `bazel run ... -- --list` for
# the full list; counts: 16 unit tests total.
