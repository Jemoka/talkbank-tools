"""chatter-cli — the `chatter` command-line tool.

Produces a single binary named `chatter` (not `chatter-cli`) per the
`[[bin]]` directive in Cargo.toml. Library code is exposed as a Rust
library target so that integration tests can link against it directly.

External Cargo deps flow through `all_crate_deps()`; intra-workspace deps
(talkbank-*, clan-core, send2clan-sys) are listed explicitly because
crate_universe doesn't know about workspace members.

Run it via Bazel:
    bazel run //crates/chatter/chatter-cli:chatter -- validate path/to/file.cha
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_INTRA_WORKSPACE_DEPS = [
    "//crates/clan/clan-core:clan_core",
    "//crates/clan/send2clan-sys:send2clan_sys",
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/core/talkbank-parser-tests:talkbank_parser_tests",
    "//crates/core/talkbank-transform:talkbank_transform",
    "//crates/core/talkbank-cache:talkbank_cache",
]

rust_binary(
    name = "chatter",
    srcs = glob(["src/main.rs", "src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "chatter",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + _INTRA_WORKSPACE_DEPS,
    rustc_env = {
        "BUILD_HASH": "{STABLE_GIT_HASH}",
    },
    stamp = 1
)

rust_test(
    name = "chatter_cli_unit_test",
    crate = ":chatter",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
