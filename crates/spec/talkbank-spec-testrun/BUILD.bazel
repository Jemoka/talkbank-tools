"""talkbank-spec-testrun — generators that need the live parser/model.

Two binaries:
  - validate_error_specs   — runs each error spec through the live parser
                              to confirm it produces the claimed error code
  - extract_corpus_candidates — mines real .cha files to discover specs

Depends on talkbank-spec-testgen (for the spec parser/format), the live
talkbank-parser + talkbank-model, and tree-sitter-talkbank.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_INTRA = [
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/spec/talkbank-spec-testgen:talkbank_spec_testgen",
    "//grammar:tree_sitter_talkbank",
]

rust_library(
    name = "talkbank_spec_testrun",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + _INTRA,
)

[
    rust_binary(
        name = bin_name,
        srcs = ["src/bin/{}.rs".format(bin_name)],
        aliases = aliases(),
        edition = "2024",
        proc_macro_deps = all_crate_deps(proc_macro = True),
        deps = all_crate_deps(normal = True) + _INTRA + [":talkbank_spec_testrun"],
    )
    for bin_name in [
        "validate_error_specs",
        "extract_corpus_candidates",
    ]
]

rust_test(
    name = "talkbank_spec_testrun_unit_test",
    crate = ":talkbank_spec_testrun",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
