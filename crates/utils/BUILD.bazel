"""talkbank-utils — workspace-level test helpers + integration tests.

Was previously the root `talkbank-tools` Rust package. Holds:
  - test_dashboard / testing_common / test_error library modules
  - 50+ integration tests under `tests/` that exercise the full
    parser → model → transform → chatter-lsp pipeline

The library piece is consumed by `tests/error_corpus/` which uses
`talkbank_utils::test_error::TestError`. The other tests don't depend
on the library; they just live here for workspace-level discoverability.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_INTRA = [
    "//crates/chatter/chatter-lsp:chatter_lsp",
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/core/talkbank-parser-tests:talkbank_parser_tests",
    "//crates/core/talkbank-transform:talkbank_transform",
    "//crates/core/talkbank-cache:talkbank_cache",
    "//grammar:tree_sitter_talkbank",
]

rust_library(
    name = "talkbank_utils",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + _INTRA,
)

rust_test(
    name = "talkbank_utils_unit_test",
    crate = ":talkbank_utils",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

