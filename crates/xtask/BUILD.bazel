"""xtask — repo automation binary.

Invoke via `bazel run //crates/xtask:xtask -- <subcommand>`. Subcommands:
audit-docs, panic-audit, wide-struct-audit, dead-variant-audit,
docs-sync, ci-hygiene, gen-runtime-toml, rust-scan,
audit-prose-references.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "xtask",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/batchalign/batchalign-types:batchalign_types",
    ],
)
