"""talkbank-parser-tests — shared test harness and fixtures.

Library crate (no [[bin]], no published API) that other crates consume
as a dev-dependency. Lots of generated fixtures under `tests/generated/`,
but those are RUN by other crates' test targets, not this one.

Bazel-hostile bits:
  - `src/lib.rs::golden` embeds the `golden_*.txt` word/tier corpora at
    the crate root via `include_str!("../golden_*.txt")`. Wired through
    `compile_data` on the library so the embed succeeds in the sandbox.
  - `tests/error_words_validation.rs` embeds `error_words_corpus.txt`
    the same way; carried on the unit-test target.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "talkbank_parser_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(["golden_*.txt"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/core/talkbank-model:talkbank_model",
        "//crates/core/talkbank-parser:talkbank_parser",
        "//grammar:tree_sitter_talkbank",
    ],
)

rust_test(
    name = "talkbank_parser_tests_unit_test",
    crate = ":talkbank_parser_tests",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = glob([
        "golden_*.txt",
        "error_words_corpus.txt",
    ]),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/core/talkbank-transform:talkbank_transform",
    ],
)

# TODO(bazel): the generated tests under tests/generated/*.rs are owned
# by `//crates/spec/talkbank-spec-testgen` (it writes them). Add a
# rust_test_suite once make-test-gen has a Bazel equivalent.
