"""talkbank-derive — proc-macro library for SemanticEq / SpanShift / ValidationTagged / error_code_enum.

This is a proc-macro crate; Bazel exposes it via `rust_proc_macro` (NOT
`rust_library`) so that downstream `proc_macro_deps` work correctly. The
crate has no build.rs.

External Cargo deps (proc-macro2, syn, quote) are pulled from crate_universe
via `all_crate_deps()` — never hand-rolled. Intra-workspace deps would be
listed explicitly here if there were any (there aren't, for this crate).
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "talkbank_derive",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "talkbank_derive",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

# trybuild tests pin the macro expansion outputs. talkbank-model is a dev
# dep here used to construct trybuild fixtures; the cycle is broken because
# the test target is downstream of the proc-macro.
rust_test(
    name = "talkbank_derive_test",
    crate = ":talkbank_derive",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/core/talkbank-model:talkbank_model",
    ],
)
