"""talkbank-parser — CST-to-model conversion via tree-sitter.

The canonical CHAT parser. Reads tree-sitter trees produced by
`tree-sitter-talkbank` (from `//grammar`) and lowers them to the
`talkbank-model` AST.

Bazel-hostile bits: none. Pure Rust library; no build.rs, no codegen,
no compile-time SQL. Benches (`benches/parse.rs`) use divan and read
fixtures from `resources/corpus/` via `include_str!` — handled with
`compile_data` so the benches build hermetically.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "talkbank_parser",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    # `parser/tree_parsing/bullet_content/tests.rs` embeds a reference
    # corpus file via `include_str!`. Compile-time presence required.
    compile_data = ["//resources/corpus:reference"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/core/talkbank-model:talkbank_model",
        "//grammar:tree_sitter_talkbank",
    ],
)

rust_test(
    name = "talkbank_parser_unit_test",
    crate = ":talkbank_parser",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    # insta `.snap` files.
    data = glob(["src/**/*.snap"]),
    env = {"INSTA_WORKSPACE_ROOT": "."},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/core/talkbank-parser-tests:talkbank_parser_tests",
    ],
)

