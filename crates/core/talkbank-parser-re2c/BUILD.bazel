"""talkbank-parser-re2c — alternate CHAT parser (spec oracle).

Independent parser implementation used as a spec oracle: every divergence
between re2c and tree-sitter points at a missing test. The lexer is
generated by `re2c` from `src/lexer.re`; the parser uses `chumsky`
combinators.

The `build.rs` copies the **vendored** generated lexer (`src/generated/
lexer.rs`, regenerated offline by `re2rust` whenever `lexer.re` changes)
into `$OUT_DIR/lexer.rs`. So re2c does NOT need to be on $PATH inside
the Bazel sandbox at build time — only the vendored file does, declared
in `data` below. To regenerate the vendored file outside of Bazel, see
the `build.rs` header for the re2rust invocation.

Tests read fixtures from `tests/fixtures/` and from the workspace
`resources/` tree via `include_str!`; declared via `compile_data`.
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "talkbank_parser_re2c_build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    data = glob(["src/*.re", "src/generated/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(build_proc_macro = True),
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "talkbank_parser_re2c",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":talkbank_parser_re2c_build_script",
        "//crates/core/talkbank-model:talkbank_model",
    ],
)

rust_test(
    name = "talkbank_parser_re2c_unit_test",
    crate = ":talkbank_parser_re2c",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = glob(["tests/fixtures/**/*"]),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/core/talkbank-parser:talkbank_parser",
    ],
)

