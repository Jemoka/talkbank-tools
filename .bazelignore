# .bazelignore: directory paths Bazel should not traverse during target
# discovery. NOTE: Bazel's path parser on Windows (Java NIO) rejects
# `*` globs in .bazelignore — every entry below must be a literal path.

# Bazel's own outputs (Unix-only symlinks; harmless on Windows)
bazel-bin
bazel-out
bazel-talkbank-tools
bazel-testlogs

# Cargo
target

# Node — every node_modules path enumerated explicitly (no `**`).
node_modules
apps/vscode-extension/node_modules
apps/vscode-extension/out
apps/vscode-extension/dist
apps/chatter/chatter-gui/node_modules

# Python
.venv
python/.venv
python/build
python/dist
python/target

# mdBook output
book/book
book/build

# Tree-sitter grammar generated artifacts
grammar/build
grammar/prebuilds
grammar/.tree-sitter

# Tauri build outputs
apps/chatter/chatter-gui/src-tauri/target
apps/chatter/chatter-gui/src-tauri/gen
