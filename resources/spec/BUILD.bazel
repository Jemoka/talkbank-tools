"""CHAT specification fixtures retained for Batchalign validation parity.

The canonical parser and specification implementation lives in Chatter;
Batchalign keeps only the documents consumed by its own tests and resources.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_files",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "constructs",
    srcs = glob(["constructs/**/*"]),
)

filegroup(
    name = "errors",
    srcs = glob(["errors/**/*"]),
)

filegroup(
    name = "symbols",
    srcs = glob(["symbols/**/*"]),
)
