"""Bazel module declaration for the talkbank-tools monorepo.

This module composes the rule sets that span the polyglot tree:

    Rust workspace            → rules_rust + crate_universe (Cargo deps)
    Python (batchalign)       → rules_uv (toolchain) + maturin (wheel build)
    Batchalign desktop app    → wrapped via sh_binary around `cargo tauri build`
    mdBook                    → wrapped via sh_binary around `mdbook build`

Cargo remains the source of truth for Rust dep resolution; Maturin remains
the source of truth for the PyO3 wheel. Bazel orchestrates, it does not
replace these tools. See CONTRIBUTING.md for the rationale.
"""

module(
    name = "talkbank_tools",
    version = "0.2.0",
    compatibility_level = 1,
)

# =============================================================================
# Rust
# =============================================================================
bazel_dep(name = "rules_rust", version = "0.70.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Hermetic protoc for crates that compile .proto at build time.
# The canonical `com_google_protobuf` repo name matches what prost-build
# and tonic-build look for via env, and is the convention rules_rust
# crate_universe uses when wiring protoc into generated BUILD files.
bazel_dep(name = "protobuf", version = "29.0", repo_name = "com_google_protobuf")

# Cargo workspace → Bazel external repo via crate_universe.
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")

# Per-crate Bazel patches and build-script env wiring for third-party
# crates whose upstream build scripts assume Cargo's single-sandbox
# semantics. Apply minimally; see `bazel/patches/BUILD.bazel`.
crate.annotation(
    crate = "ferrous-opencc",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:ferrous-opencc-0.4.0.patch"],
)

crate.annotation(
    crate = "talkbank-parser-re2c",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:talkbank-parser-re2c-0.16.0.patch"],
)

# The model build script reads the vendored ISO registry at build time. The
# generated catch-all data glob does not traverse the git crate's symlinked
# `data/` directory on Windows, so name the input explicitly for its runfiles.
crate.annotation(
    additive_build_file_content = """
filegroup(
    name = "iso639_data",
    srcs = ["data/iso639-3.tsv"],
)
""",
    build_script_data = [":iso639_data"],
    crate = "talkbank-model",
)

# The git crate references a schema stored above its Cargo package root.
# crate_universe isolates package roots, so expose the tracked schema through
# an explicit compile-time path until upstream packages it inside the crate.
crate.annotation(
    compile_data = ["@@//schemas/chat-file:chat-file.schema.json"],
    crate = "talkbank-transform",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:talkbank-transform-0.16.0.patch"],
    repositories = ["crates"],
    rustc_env = {
        "TALKBANK_CHAT_SCHEMA": "$(execpath @@//schemas/chat-file:chat-file.schema.json)",
    },
)

# PyO3 build-script handling. The default pyo3-build-config / pyo3-ffi
# build scripts probe the host CPython and emit
# `cargo:rustc-link-lib=python3.X`, which forces the linker to find
# libpython. We avoid that by pointing the build scripts at a static
# config file (`//bazel/python:pyo3_config`) that declares
# abi3-py312 + `suppress_build_script_link_lines=true` — no host probe,
# no libpython link directive. The macOS rustc flag
# `-C link-arg=-undefined -C link-arg=dynamic_lookup` (set on the
# `rust_shared_library` in batchalign-engine) handles the actual link.
crate.annotation(
    build_script_data = ["@@//bazel/python:pyo3_config"],
    build_script_env = {
        "PYO3_CONFIG_FILE": "$(execpath @@//bazel/python:pyo3_config)",
    },
    crate = "pyo3-build-config",
    repositories = ["crates"],
)
crate.annotation(
    build_script_data = ["@@//bazel/python:pyo3_config"],
    build_script_env = {
        "PYO3_CONFIG_FILE": "$(execpath @@//bazel/python:pyo3_config)",
    },
    crate = "pyo3-ffi",
    repositories = ["crates"],
)

# Enable abi3 + abi3-py310 features on the pyo3 crate so its macros emit
# Py_LIMITED_API guards. The resulting `_core.so` runs on CPython 3.10
# through whatever future version still supports the stable ABI. Mirror
# of the `abi3-py310` in crates/batchalign/batchalign-engine/Cargo.toml
# (Bazel crate_universe doesn't read upstream features — annotations
# override). Bump in lockstep with that Cargo.toml and the abi3 version
# line in bazel/python/pyo3-config.txt.
crate.annotation(
    crate = "pyo3",
    crate_features = [
        "abi3",
        "abi3-py310",
    ],
    repositories = ["crates"],
)

# iana-time-zone uses windows-core's Error as a std::io::Error payload on
# Windows. Cargo enables windows-core's default `std` feature, but
# crate_universe omits it when generating the Windows exec graph unless it is
# explicit, leaving the Error type without its std::error::Error impl.
crate.annotation(
    crate = "windows-core",
    crate_features = ["std"],
    repositories = ["crates"],
)

# Feed hermetic protoc into every crate whose build script invokes it.
# Without these annotations, crate_universe-generated BUILD files have
# no protoc input and prost-build panics with "Could not find protoc".
#
# We reference the bzlmod **canonical** repo name (`@@protobuf~`) rather
# than the apparent name (`@com_google_protobuf`) because crate_universe-
# generated repos do not inherit the root module's apparent-name mapping
# (bzlmod isolates repo visibility per module). The canonical name is
# stable within a Bazel + protobuf-module-version pair; if it changes
# (e.g. Bazel switches the `~` suffix), update here.
_PROTOC_DATA = [
    "@@protobuf~//:protoc",
    "@@protobuf~//:well_known_type_protos",
]

_PROTOC_ENV = {
    "PROTOC": "$(execpath @@protobuf~//:protoc)",
    # PROTOC_INCLUDE must point at a directory whose layout has
    # `google/protobuf/*.proto`. The well_known_type_protos filegroup
    # materializes those files at `external/protobuf~/src/google/protobuf/`,
    # so we point PROTOC_INCLUDE at `external/protobuf~/src`. The
    # cargo_build_script_runner resolves this execroot-relative path
    # to an absolute path before invoking the build script.
    "PROTOC_INCLUDE": "$${pwd}/external/protobuf~/src",
    # "external/protobuf~/src",
}

# protoc annotations retired with the batchalign-cli/temporal stack
# (spec2.md torch-and-rewrite). Reintroduce if a future crate needs protoc.

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    # Only the root manifest is listed. crate_universe walks the
    # [workspace] members table to discover every member crate.
    manifests = ["//:Cargo.toml"],
    # crate_universe's reduced defaults omit Intel macOS. Keep this list in
    # lockstep with the native wheel matrix so generated third-party crates
    # are compatible on every release host.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# pyapp source — Bazel fetches it lazily via git_repository (only
# materialized when a downstream target actually consumes @pyapp_src,
# e.g. //python/batchalign:sidecar). Contributors building paths
# that don't touch the sidecar never trigger the fetch — no manual
# `git submodule update --init` required.
#
# The compile itself happens in the sidecar genrule (with
# local = True): it invokes Bazel-provided cargo (from rules_rust's
# host toolchain) against this source with `cargo install --path
# $(execpath @pyapp_src//:srcs_root)` — no crates.io network access,
# no host cargo dependency. local = True is required because pyapp's
# build.rs writes to $CARGO_MANIFEST_DIR/src/embed/ (an upstream
# design choice we can't change), which Bazel sandboxes mark
# read-only; cargo install bypasses this by creating a writable tmpdir
# copy of the source before invoking the build script.
git_repo = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "new_git_repository",
)
git_repo(
    name = "pyapp_src",
    remote = "https://github.com/ofek/pyapp.git",
    commit = "b2dbcfa822db0e390c0ea2d8d965392903b776c4",  # v0.27.0
    shallow_since = "1738400000 +0000",  # approx tag date; bumped if commit changes
    build_file_content = """
package(default_visibility = ["//visibility:public"])

# Surface the entire pyapp source tree as one filegroup. The sidecar
# genrule resolves the on-disk path via $(execpath …) and hands it to
# `cargo install --path` so cargo uses local source (no crates.io).
filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        allow_empty = False,
        exclude = ["**/BUILD.bazel", "**/BUILD"],
    ),
)

# Cargo.toml is referenced via the file path directly (Bazel
# auto-exports files in external repositories) — the sidecar genrule
# uses `$(execpath @pyapp_src//:Cargo.toml)` to anchor `cargo install
# --path` at pyapp's source root.
exports_files(["Cargo.toml"])
""",
)

# tauri-cli source — Bazel-fetched http_archive from crates.io,
# pinned by SHA. The `cargo-tauri` binary it produces is required by
# the GUI bundle/dev path (`cargo tauri build|dev`); installing it on
# the host (`cargo install tauri-cli`) would break the "bazel + just
# only" contract. Built by the Bazel-managed cargo install + staged
# onto PATH by bazel/batchalign-tauri/{bundle,dev}.sh.
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)
http_archive(
    name = "tauri_cli_src",
    urls = ["https://static.crates.io/crates/tauri-cli/tauri-cli-2.11.2.crate"],
    sha256 = "2da40a7a42eae3f74eb4783e78378e0d8ce84ac8258e1c123443755609cd3277",
    strip_prefix = "tauri-cli-2.11.2",
    type = "tar.gz",  # .crate files are gzipped tarballs
    build_file_content = """
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        allow_empty = False,
        exclude = ["**/BUILD.bazel", "**/BUILD"],
    ),
)

exports_files(["Cargo.toml"])
""",
)

# crates.io packages omit Cargo.lock. Pair the pinned CLI source with the lock
# from its matching upstream release tag so fresh CI runs cannot resolve a
# different, internally incompatible transitive graph.
http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)
http_file(
    name = "tauri_cli_lock",
    downloaded_file_path = "Cargo.lock",
    sha256 = "045da6ee8370fc701e1d5196469c862c029fb5da47a22862749ea6a0757d67d5",
    urls = ["https://raw.githubusercontent.com/tauri-apps/tauri/tauri-cli-v2.11.2/Cargo.lock"],
)

# =============================================================================
# Python — rules_uv (deps) → rules_python (py_*) → rules_rust (cdylib via
# maturin) → wheel ready to ship.
# =============================================================================
# Pinned to Python 3.12 across the board: rules_python's hermetic toolchain,
# the uv-resolved venv (`uv.lock`), and pyproject's `requires-python` all
# agree. Bumping requires updating MODULE.bazel, .bazelrc, python/pyproject.toml,
# and python/uv.lock in a single commit.
#
# rules_uv exposes a hermetic `uv` binary; uv.lock is the source of truth
# for runtime Python deps. Maturin (the PyO3 wheel backend) is invoked as
# `uv run maturin build --release` from sh_binary wrappers — modelling the
# cdylib + ABI-tagged rename + wheel packaging in Bazel buys nothing here.
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_uv", version = "0.59.0")

# Single source of truth for the Python interpreter pin. Flows into the
# rules_python toolchain, the uv-managed venv, and the maturin host
# (asserted at script entry — see bazel/python/hermeticity_guard.sh).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# uv binary. `pip_compile` from `@rules_uv//uv:pip.bzl` is loaded in
# `python/BUILD.bazel`; rules_uv 0.59.0 does not export a module
# extension at `@rules_uv//uv:extensions.bzl`, so we do not register a
# `uv.toolchain(...)` here. The uv binary itself comes from
# `@multitool//tools/uv` (see `multitool.lock.json`), invoked by the
# maturin/pyapp shell-out scripts directly. The uv version pin lives
# in `python/pyproject.toml [tool.batchalign.pinned_tools]` and is
# enforced by `bazel/python/hermeticity_guard.sh`.

# `@pypi//*` hub generated from python/requirements.lock.txt (which
# `pip_compile` produces from pyproject.toml's `[project] dependencies`
# + all `[project.optional-dependencies]` via `--all-extras`).
# `all_requirements` from this hub gives BUILD files a wildcard
# import — no hand-listed names.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//python:requirements.lock.txt",
)
use_repo(pip, "pypi")

# =============================================================================
# Shell / OCI / archive utilities
# =============================================================================
bazel_dep(name = "rules_shell", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Bazel 8 stops transitively re-exporting @platforms from other rules.
# Targets that `select()` on @platforms//os or @platforms//cpu need an
# explicit bazel_dep here.
bazel_dep(name = "platforms", version = "1.0.0")

# `copy_to_directory` is used wherever a Rust target needs an
# in-sandbox manifest-dir layout that mirrors the source tree
# (sqlx::migrate! and friends parse a string literal and require
# `CARGO_MANIFEST_DIR/<literal>` to canonicalize at proc-macro time).
bazel_dep(name = "aspect_bazel_lib", version = "2.9.3")

# =============================================================================
# C / C++ toolchain — hermetic LLVM via toolchains_llvm
# =============================================================================
# Why hermetic clang?
#
# Every maturin-driven Rust build (wheel, sidecar) eventually shells out
# to `cargo build` -> `cc-rs` -> the C compiler on PATH. On macOS that's
# `/usr/bin/cc`, which is Apple's clang from /Library/Developer/
# CommandLineTools. The host clang + host SDK are a versioned pair; a
# mismatch breaks every `*-sys` crate. The macOS 26.x CommandLineTools
# regression (clang 21 vs MacOSX.sdk's new `__kernel_ptr_semantics`
# attribute macro) made this concrete -- libsqlite3-sys fails to compile
# any time it's transitively pulled in, with no path to fix without
# either installing Xcode.app or downgrading CLT.
#
# `toolchains_llvm` pins a specific LLVM release from llvm.org's prebuilt
# tarballs; combined with cflag injection below, every cc invocation
# Bazel orchestrates uses the pinned compiler. The maturin escape scripts
# (`bazel/python/{maturin,pyapp}_build.sh`) read CC/CXX from runfiles and
# export them to cargo, so even the shelled-out maturin path picks up the
# hermetic compiler instead of host clang.
#
# SDK handling: on macOS the SDK still comes from xcrun (system). The
# clang workaround for the `__kernel_ptr_semantics` regression lives in
# the toolchain's default cflags (see :compiler_cflags below), NOT in
# bash. If/when a hermetic SDK is needed (CI matrix, license-clean OSS
# distribution, etc.), point `llvm.sysroot()` at a downloaded SDK
# archive -- see https://github.com/bazel-contrib/toolchains_llvm#configuration.
bazel_dep(name = "toolchains_llvm", version = "1.7.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    # `__kernel_ptr_semantics` / `__kernel_data_semantics` are trailing
    # attribute macros in <mach/arm/vm_types.h> that the SDK defines
    # conditionally on clang-version detection. On CommandLineTools 26.x
    # the detection path is broken and the macros end up undefined when
    # third-party C code includes the header, causing "expected ';'
    # after top level declarator" parse errors. Defining them to empty
    # gives the same semantics older SDKs had (plain typedef without
    # the kernel-only attribute) -- correct for any non-kernel consumer.
    # See bazel/python/{maturin,pyapp}_build.sh for the cc-rs mirror;
    # the two must agree.
    extra_compile_flags = {
        "darwin-aarch64": [
            "-D__kernel_ptr_semantics=",
            "-D__kernel_data_semantics=",
        ],
        "darwin-x86_64": [
            "-D__kernel_ptr_semantics=",
            "-D__kernel_data_semantics=",
        ],
    },
    # LLVM's published host archives vary by release. Keep the established
    # 17.0.6 toolchain where it exists, and select 19.1.7 for Intel macOS,
    # which lacks a usable 17.0.6 archive. The map is resolved by exec host,
    # so ARM macOS does not download the much larger Intel distribution.
    # toolchains_llvm deliberately disables itself on Windows; wheel builds
    # there use the hosted Visual Studio toolchain.
    #
    # Note: hermetic LLVM alone does NOT make the wheel build hermetic
    # against host-toolchain breakage -- the macOS SDK still comes from
    # xcrun (system). On hosts with a broken CommandLineTools (e.g.
    # macOS 26.x CLT 26.4, where clang 21 + the bundled SDK fail to
    # compile their own headers), `*-sys` crate builds will still fail
    # at the SDK header layer. The fix is either (a) install Xcode.app
    # so xcrun returns the Xcode SDK instead of the CLT one, (b) wait
    # for Apple to ship a fixed CLT, or (c) vendor a known-good SDK
    # via http_archive + llvm.sysroot(). See CONTRIBUTING.md for the
    # decision tree.
    llvm_versions = {
        "": "17.0.6",
        "darwin-x86_64": "19.1.7",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# =============================================================================
# Hermetic external binaries via rules_multitool
# =============================================================================
# Tools that don't have a first-class Bazel ruleset (currently uv and mdbook)
# are fetched as platform-specific
# prebuilt binaries from their upstream GitHub releases and exposed as
# `@multitool//tools/<name>`. SHA256s live in `multitool.lock.json`.
bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")
