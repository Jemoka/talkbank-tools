# Dockerfile.dev — exercises the local debug path end-to-end inside a
# clean Ubuntu image. Clones the repo from the bind-mounted source,
# installs minimal host prerequisites (bazelisk, just, build-essential
# for cargo's C deps, the pinned rustup channel), and runs
# `just batchalign cli -- compare ...`.
#
# Local-only path: NO maturin in the run path. The cdylib is built by
# Bazel's `rust_shared_library` and consumed by `py_binary` via
# runfiles. This image only exists to *prove* a fresh machine can do
# `git clone && just batchalign cli` without a maturin install.
#
# Built / invoked from `just docker dev-test` (see just/docker.just).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Host prerequisites: bazelisk, just, build-essential (needed by cargo
# for any C deps cargo-builds at action time), curl/git, libsqlite3-dev
# (for libsqlite3-sys to skip its vendored compile and link the system
# library — sidesteps the macOS-only header bug on this Linux image).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git unzip xz-utils \
        build-essential pkg-config \
        libsqlite3-dev \
        python3.12 python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Bazelisk (auto-fetches the version pinned in .bazelversion). Arch-aware:
# Docker on Apple Silicon defaults to arm64 containers; the linux-amd64
# binary would only run through qemu and fail to find /lib64/ld-linux-*.
RUN arch="$(uname -m)" && case "$arch" in \
        x86_64)  triple=linux-amd64 ;; \
        aarch64) triple=linux-arm64 ;; \
        *) echo "unsupported arch: $arch" >&2; exit 2 ;; \
    esac && \
    curl -fsSL -o /usr/local/bin/bazel \
        "https://github.com/bazelbuild/bazelisk/releases/download/v1.22.1/bazelisk-${triple}" \
    && chmod +x /usr/local/bin/bazel

# just.
RUN curl -fsSL --proto '=https' --tlsv1.2 \
        https://just.systems/install.sh \
    | bash -s -- --to /usr/local/bin

# Rust toolchain — must match python/pyproject.toml [tool.batchalign.pinned_tools].rust.
RUN curl -fsSL --proto '=https' --tlsv1.2 \
        https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.95.0
ENV PATH=/root/.cargo/bin:${PATH}

# uv — must match the same pin.
RUN curl -fsSL --proto '=https' --tlsv1.2 \
        https://astral.sh/uv/0.5.18/install.sh | sh
ENV PATH=/root/.local/bin:${PATH}

# rules_python refuses to run its hermetic interpreter as root
# (https://github.com/bazelbuild/rules_python/pull/713). Create a
# non-root user and switch to it; cargo/uv/just stay reachable via
# /usr/local/bin and the user-local rust toolchain was installed
# into /root previously, so we move that too.
RUN useradd -m -u 1001 -s /bin/bash dev \
    && mkdir -p /home/dev/.cargo /home/dev/.rustup /home/dev/.local \
    && cp -a /root/.cargo/. /home/dev/.cargo/ \
    && cp -a /root/.rustup/. /home/dev/.rustup/ \
    && cp -a /root/.local/. /home/dev/.local/ \
    && chown -R dev:dev /home/dev

USER dev
ENV HOME=/home/dev \
    PATH=/home/dev/.cargo/bin:/home/dev/.local/bin:${PATH}

# Constrain Bazel + rustc to fit Docker Desktop's default 8GB RAM
# budget. Without these, the JVM + parallel rustc actions OOM-kill the
# build server ("Server terminated abruptly: Socket closed"). Two jobs
# is conservative but works on the smallest-likely-host configuration.
RUN printf 'startup --host_jvm_args=-Xmx1500m\nbuild --jobs=1\nbuild --local_ram_resources=3072\nbuild --local_cpu_resources=1\n' \
       > /home/dev/.bazelrc

WORKDIR /work
# Source is bind-mounted at runtime via `just docker dev-test`; the
# image stays small and rebuilds don't invalidate the apt layer.

CMD ["bash", "-lc", "just batchalign cli -- --help"]
