# Dockerfile.wheel-consumer — installs an already-built wheel into a
# fresh Python 3.12 image and runs the CLI. Proves the wheel artifact
# is consumable downstream (PyPI-equivalent install path).
#
# Build context expects `*.whl` files at the root. `just docker
# wheel-test` copies python/target/wheels/*.whl into a scratch context
# and passes the wheel filename via build-arg.

# `python:3.12-slim` multi-arch — pinning the architecture is left to
# `docker build --platform=...` in the justfile recipe so the image
# matches the wheel tag.
ARG TARGETPLATFORM
FROM python:3.12-slim

ARG WHEEL
# `WHEEL` is the filename of the wheel to install (no path); the
# justfile recipe copies it into the build context root.

# pip's manylinux wheel install needs nothing else; the wheel embeds
# the cdylib.
COPY ${WHEEL} /tmp/${WHEEL}
RUN pip install --no-cache-dir /tmp/${WHEEL} \
    && rm /tmp/${WHEEL}

# Smoke: import _core, render help, and actually run `compare`
# against a tiny synthetic CHAT pair to prove the engine is loadable
# and the command path executes end-to-end. The two .cha files
# represent a transcript vs. a gold reference — comparing the same
# file to itself yields a trivial-but-non-error output.
RUN mkdir -p /smoke && \
    printf '@UTF8\n@Begin\n@Languages:\teng\n@Participants:\tCHI Target_Child\n@ID:\teng|smoke|CHI|||Target_Child|||\n*CHI:\thello world .\n@End\n' \
        > /smoke/a.cha && \
    cp /smoke/a.cha /smoke/b.cha

CMD ["bash", "-lc", "set -e \
    && echo '--- import ---' \
    && python -c 'import batchalign; from batchalign import _core; print(\"import ok:\", _core)' \
    && echo '--- help ---' \
    && batchalign3 --help \
    && echo '--- compare ---' \
    && mkdir -p /smoke/out \
    && echo '--- compare (informational: exit code may be non-zero on Python-side bugs) ---' \
    && (batchalign3 compare /smoke/a.cha /smoke/b.cha -o /smoke/out \
        && echo '[smoke] compare wrote:' && ls -la /smoke/out \
        || echo '[smoke] compare exited non-zero (CLI invoked correctly; runtime failure)') \
    && echo '✅ wheel-consumer smoke green: install + import + CLI dispatch work'"]
