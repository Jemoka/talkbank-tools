        "description": "Discriminated JSON for a backend.\n\nThe set of valid ``kind`` strings is the set of names in\n:data:`BACKEND_CLASSES`. ``kwargs`` is forwarded straight to the\nconstructor; we validate it against ``inspect.signature`` at\nmaterialization (not at request-parse) so nested backend kwargs\n(e.g. ``stanza_fallback``) can themselves be ``BackendSpec``.",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "kwargs": {
            "additionalProperties": true,
            "title": "Kwargs",
            "type": "object"
          }
        },
        "required": [
          "kind"
        ],
        "title": "BackendSpec",
        "type": "object"
      },
