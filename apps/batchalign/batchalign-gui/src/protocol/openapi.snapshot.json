      "InputSpec": {
        "additionalProperties": false,
        "description": "Uniform input descriptor.\n\nExactly one of ``upload_id`` / ``url`` / ``path`` must be set for the\nprimary slot. ``paired`` additionally needs a gold counterpart via\n``gold_upload_id`` / ``gold_url`` / ``gold_path``.\n\n``path`` is honored only when the server is configured to trust local\npaths (off by default \u2014 set ``BATCHALIGN_API_ALLOW_PATHS=1``).",
        "properties": {
          "gold_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gold Path"
          },
          "gold_upload_id": {
