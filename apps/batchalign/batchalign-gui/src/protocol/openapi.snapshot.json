            "default": "media",
            "enum": [
              "media",
              "chat",
              "paired"
            ],
            "title": "Kind",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
