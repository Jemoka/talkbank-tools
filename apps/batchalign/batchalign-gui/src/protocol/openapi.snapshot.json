    "/backends": {
      "get": {
        "operationId": "list_backends_backends_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Backends Backends Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Backends"
      }
    },
    "/capabilities": {
      "get": {
        "description": "One-stop discovery: every recipe, every backend, input shape, job lifecycle.\n\nClients should hit this to learn what the server can do without\nreading the OpenAPI schema. The contents are derived entirely from\nintrospection \u2014 adding a recipe or backend in the source updates\nthis response automatically.",
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Capabilities Capabilities Get",
