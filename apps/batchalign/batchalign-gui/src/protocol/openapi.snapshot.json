    "/recipes/compare": {
      "post": {
        "description": "Gold/main transcript comparison.\n\nWires ``[Morphosyntax, Compare]``. Morphosyntax runs on both sides of\nthe ``Paired`` (the runner short-circuits per-utterance if `%mor:` is\nalready present), so the compare backend can lift POS off the `%mor`\ntier to populate ``%xsmor``.\n\n``compare_backend`` defaults to the native Rust\n``batchalign._core.CompareBackend``. ``stanza_backend`` is required\nfor `%xsmor` to carry real POS tags.",
        "operationId": "run_compare_recipes_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Run Compare Recipes Compare Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Compare"
      }
    },
