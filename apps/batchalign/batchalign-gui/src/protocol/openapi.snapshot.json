    "/recipes/transcribe": {
      "post": {
        "description": "ASR + utterance segmentation (+ optional speaker diarization).\n\nThis is BA2's transcribe *pairing*: ASR, then a utterance-segmentation\nstage. Pass `utseg_backend=CHATUtteranceBackend(...)` for BA2's BERT\nsegmenter (the parity path, applied uniformly to whichever ASR engine\nproduced the words). Pyannote, if given as `speaker_backend`, services\nboth Speaker and UtSeg, so it covers segmentation on its own.\n\nForce-alignment is *not* wired here \u2014 compose `align(fa_backend=...)`\nafterwards for refined word-level timings.",
        "operationId": "run_transcribe_recipes_transcribe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscribeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Run Transcribe Recipes Transcribe Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Transcribe"
      }
    },
