  "config": {
    "allow_server_paths": false
  },
  "endpoints": {
    "job_cancel": {
      "method": "DELETE",
      "path": "/jobs/{id}"
    },
    "job_events_sse": {
      "method": "GET",
      "path": "/jobs/{id}/events"
    },
    "job_result": {
      "method": "GET",
      "path": "/jobs/{id}/result"
    },
    "job_status": {
      "method": "GET",
      "path": "/jobs/{id}"
    },
    "run_recipe": {
      "method": "POST",
      "path": "/recipes/{name}"
    },
    "upload": {
      "method": "POST",
      "path": "/uploads"
    }
  },
  "input_kinds": [
    "media",
    "chat",
    "paired"
  ],
  "job_states": [
    "pending",
    "running",
    "completed",
    "failed",
    "cancelled"
  ],
  "recipes": {
    "align": {
      "accepts_pipeline_opts": true,
      "doc": "Forced alignment only (`Task.Fa`).",
      "endpoint": "/recipes/align",
      "params": [
        {
          "annotation": "'Any'",
          "default": null,
          "is_backend": true,
          "name": "fa_backend",
          "required": true
        }
      ],
      "request_schema_ref": "#/components/schemas/AlignRequest"
    },
    "compare": {
      "accepts_pipeline_opts": true,
      "doc": "Gold/main transcript comparison.\n\nWires ``[Morphosyntax, Compare]``. Morphosyntax runs on both sides of\nthe ``Paired`` (the runner short-circuits per-utterance if `%mor:` is\nalready present), so the compare backend can lift POS off the `%mor`\ntier to populate ``%xsmor``.\n\n``compare_backend`` defaults to the native Rust\n``batchalign._core.CompareBackend``. ``stanza_backend`` is required\nfor `%xsmor` to carry real POS tags.",
      "endpoint": "/recipes/compare",
      "params": [
        {
          "annotation": "'Any'",
          "default": null,
          "is_backend": true,
          "name": "stanza_backend",
          "required": true
        },
        {
          "annotation": "'Any'",
          "default": "None",
          "is_backend": true,
          "name": "compare_backend",
          "required": false
        }
      ],
      "request_schema_ref": "#/components/schemas/CompareRequest"
    },
    "coref": {
      "accepts_pipeline_opts": true,
      "doc": "Coreference resolution.",
      "endpoint": "/recipes/coref",
      "params": [
        {
          "annotation": "'Any'",
          "default": null,
          "is_backend": true,
          "name": "coref_backend",
          "required": true
        }
      ],
      "request_schema_ref": "#/components/schemas/CorefRequest"
    },
    "morphotag": {
      "accepts_pipeline_opts": true,
      "doc": "Morphosyntax tagging via Stanza (UD `%mor` / `%gra`).",
      "endpoint": "/recipes/morphotag",
      "params": [
        {
          "annotation": "'Any'",
          "default": null,
          "is_backend": true,
          "name": "stanza_backend",
          "required": true
        }
      ],
      "request_schema_ref": "#/components/schemas/MorphotagRequest"
    },
    "transcribe": {
      "accepts_pipeline_opts": true,
