{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batchalign",
  "mainBinaryName": "Batchalign",
  "version": "0.1.0",
  "identifier": "org.talkbank.batchalign",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Batchalign",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "externalBin": ["binaries/sidecar"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
