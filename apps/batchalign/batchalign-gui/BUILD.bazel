"""Bazel filegroup for the Batchalign desktop GUI frontend.

The Tauri bundle target (`src-tauri:bundle`) depends on this filegroup so
the wrapper script (bazel/batchalign-tauri/bundle.sh) sees the frontend
sources staged in its runfiles before invoking `cargo tauri build`.

The actual build (Vite + cargo + Tauri bundler) escapes the Bazel sandbox
— see bazel/batchalign-tauri/bundle.sh and apps/chatter/chatter-gui/
CLAUDE.md for the same pattern's rationale.

The OpenAPI freshness gate is a `py_test` (NOT a sh_test against the
host's uv-managed venv), so Bazel manages the Python toolchain and
deps end-to-end — no `uv sync` is required before `bazel test`.
"""

load("//bazel/python:deps.bzl", "all_runtime_deps")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "frontend_sources",
    srcs = glob(
        [
            "package.json",
            "package-lock.json",
            "vite.config.ts",
            "tsconfig.json",
            "index.html",
            "src/**/*.ts",
            "src/**/*.tsx",
            "src/**/*.css",
            "src/**/*.json",
        ],
        allow_empty = True,
    ),
)

# Regenerate src/protocol/openapi.gen.ts + capabilities.snapshot.json
# from the live daemon's `app.openapi()` and `GET /capabilities`. The
# script shells out to `openapi-typescript` (installed via the GUI's
# package.json) and writes to the source tree.
py_binary(
    name = "openapi",
    srcs = ["//scripts:gen_openapi.py"],
    main = "//scripts:gen_openapi.py",
    package_collisions = "ignore",
    deps = [
        "//python/batchalign:batchalign_lib",
    ] + all_runtime_deps(),
)

# Freshness gate. CI runs this to catch drift between the committed
# openapi.gen.ts / capabilities.snapshot.json and what the daemon would
# emit *right now*. Same pattern as `generated-check` in the symbol
# registry — runs the generator with --check, fails on diff.
#
# Bazel manages the Python interpreter + every dep (including fastapi /
# uvicorn / sse-starlette via the dev extra in pyproject.toml + the
# requirements lock). No `uv sync` is required ahead of `bazel test`.
py_test(
    name = "test_openapi_freshness",
    srcs = ["//scripts:gen_openapi.py"],
    main = "//scripts:gen_openapi.py",
    args = ["--check"],
    # Committed artifacts the test diffs against — must be in runfiles
    # for `gen_openapi.py` to read them via `repo_root() / ...`.
    # Committed JSON snapshots the hermetic check diffs against. The
    # .ts file is a downstream codegen artifact (needs node +
    # node_modules) regenerated by `bazel run //...:openapi`; not
    # checked here.
    data = [
        "src/protocol/openapi.snapshot.json",
        "src/protocol/capabilities.snapshot.json",
    ],
    package_collisions = "ignore",
    deps = [
        "//python/batchalign:batchalign_lib",
    ] + all_runtime_deps(),
)
