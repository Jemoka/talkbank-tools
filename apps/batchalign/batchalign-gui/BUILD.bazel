"""Bazel filegroup for the Batchalign desktop GUI frontend.

The Tauri bundle target (`src-tauri:bundle`) depends on this filegroup so
the wrapper script (bazel/batchalign-tauri/bundle.sh) sees the frontend
sources staged in its runfiles before invoking `cargo tauri build`.

The actual build (Vite + cargo + Tauri bundler) escapes the Bazel sandbox;
see bazel/batchalign-tauri/bundle.sh.

Protocol artifacts are generated by Bazel from the live Python API
surface. They are not checked into the source tree.
"""

load("//bazel/python:deps.bzl", "all_runtime_deps")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "frontend_sources",
    srcs = glob(
        [
            "package.json",
            "package-lock.json",
            "vite.config.ts",
            "tsconfig.json",
            "index.html",
            "src/**/*.ts",
            "src/**/*.tsx",
            "src/**/*.css",
            "src/**/*.json",
        ],
        allow_empty = True,
    ) + [":protocol_artifacts"],
)

py_binary(
    name = "_gen_openapi",
    srcs = ["//scripts:gen_openapi.py"],
    main = "//scripts:gen_openapi.py",
    deps = [
        "//python/batchalign:batchalign_lib",
    ] + all_runtime_deps(),
)

genrule(
    name = "protocol_artifacts",
    outs = [
        "openapi.snapshot.json",
        "capabilities.snapshot.json",
    ],
    tools = [":_gen_openapi"],
    cmd = "$(execpath :_gen_openapi) --out-dir $(RULEDIR)",
)
