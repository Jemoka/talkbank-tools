"""batchalign-gui-dashboard — Tauri shell wrapping the React dashboard.

This is a minimal Tauri app that embeds the React dist from
`//apps/batchalign/batchalign-cli-webdashboard:dist` and forwards
window events to the batchalign3 server. No intra-workspace Rust deps.

Like chatter-gui, the full bundle (.app/.exe/AppImage) is produced by
`bazel run //apps/batchalign/batchalign-gui-dashboard:bundle` (sh_binary
wrapper around `cargo tauri build`).
"""

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "batchalign_gui_dashboard_build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    data = glob([
        "tauri.conf.json",
        "icons/**/*",
        "capabilities/**/*",
    ]),
    edition = "2021",
    proc_macro_deps = all_crate_deps(build_proc_macro = True),
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "batchalign_gui_dashboard_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
        allow_empty = True,
    ),
    aliases = aliases(),
    compile_data = [
        "//apps/batchalign/batchalign-cli-webdashboard:dist",
    ],
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":batchalign_gui_dashboard_build_script",
    ],
)

rust_binary(
    name = "batchalign-gui-dashboard",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "batchalign_gui_dashboard",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":batchalign_gui_dashboard_build_script",
        ":batchalign_gui_dashboard_lib",
    ],
)

rust_test(
    name = "batchalign_gui_dashboard_unit_test",
    crate = ":batchalign_gui_dashboard_lib",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
