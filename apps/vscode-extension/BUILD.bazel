"""talkbank-chat — VS Code extension (TypeScript).

The extension launches `chatter-lsp` over stdio and exposes commands,
syntaxes, snippets, and language definitions for CHAT.

Three actions wrapped here:
  - `build`   → npm/pnpm build → out/extension.js
  - `package` → vsce package → .vsix file
  - `test`    → mocha + vscode-test runner

Native rules_ts handles the TypeScript compile, but the VS Code-specific
packaging (`vsce package`) is shelled out because no Bazel ruleset covers it.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["src/test/fixtures/executeCommandContract.json"],
    visibility = ["//visibility:public"],  # or restrict to specific packages
)

sh_binary(
    name = "build",
    srcs = ["//bazel/vscode:build.sh"],
    data = glob(
        [
            "src/**/*",
            "syntaxes/**/*",
            "snippets/**/*",
            "language-configuration.json",
            "package.json",
            "package-lock.json",
            "tsconfig.json",
        ],
        allow_empty = True,
    ),
)

sh_binary(
    name = "package",
    srcs = ["//bazel/vscode:package.sh"],
    data = [":build"],
)

sh_binary(
    name = "test",
    srcs = ["//bazel/vscode:test.sh"],
    data = glob(["src/**/*", "tests/**/*"], allow_empty = True),
)
