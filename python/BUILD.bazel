"""Python product root.

`pyproject.toml` is the source of truth for Python deps. `pip_compile`
(`rules_uv`) renders it into a hash-locked, universal `requirements.lock.txt`
that `pip.parse` (in MODULE.bazel) consumes.

  bazel run  //python:requirements         # regenerate after pyproject edit
  bazel test //python:requirements_test    # CI gate: fails if lockfile drifted

`bazel test //...` runs `:requirements_test` automatically because
`pip_compile` puts it in the default test set. A PR that touches
`pyproject.toml` without regenerating the lockfile will fail CI here,
which is the closest we get to "every build keeps everything in sync"
without making pip.parse itself a build-time action.

The wheel build path remains maturin (sole pyproject reader for the
multi-platform tagging matrix); it lives at //python/batchalign:wheel.
"""

load("@rules_uv//uv:pip.bzl", "pip_compile")

package(default_visibility = ["//visibility:public"])

pip_compile(
    name = "requirements",
    requirements_in = "pyproject.toml",
    requirements_txt = "requirements.lock.txt",
    # Universal lockfile covers all platforms; uv picks the highest
    # version compatible with every supported marker.
    #
    # Extras included in the lockfile (so `requirement("foo")` works in
    # py_library/py_binary/py_test):
    #   dev     — pytest, twine, mypy (test/lint deps)
    #   stanza  — stanza + its transitive torch closure; needed by
    #             `recipes.compare()` via `MorphosyntaxTaskRunner` and
    #             surfaces under `bazel run //python/batchalign:batchalign
    #             -- compare ...`.
    #
    # Other optional-dep groups (whisper, vllm, pyannote, etc.) are NOT
    # in the lockfile because they're huge and would slow down every
    # `bazel test //...` invocation. Wheel consumers pick them up via
    # `pip install batchalign[whisper]` — maturin reads pyproject.toml
    # directly for those.
    extra_args = [
        "--extra",
        "dev",
        "--extra",
        "stanza",
    ],
    universal = True,
)

filegroup(
    name = "project_metadata",
    srcs = [
        "pyproject.toml",
        "pytest.ini",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "batchalign/**/*.py",
            "batchalign/**/*.pyi",
        ],
        allow_empty = True,
    ),
)

exports_files([
    "pyproject.toml",
    "pytest.ini",
    "requirements.lock.txt",
])
