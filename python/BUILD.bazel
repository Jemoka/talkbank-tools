"""Python product root.

Source-of-truth chain:
  `pyproject.toml`  →  `requirements.lock.txt`  →  `@pypi//*`

Pip dep resolution is two-step (rules_python's `pip.parse` reads only
checked-in lockfiles; Bazel's loading phase cannot run uv lock). So:

  - `pyproject.toml` is the only place runtime deps are *named*.
  - `requirements.lock.txt` is the Bazel-readable rendering of those
    names with hash-locked versions. The `tools/bazel` Bazelisk
    wrapper auto-regenerates it before every Bazel invocation when
    `pyproject.toml` is newer (see `//python:requirements` below;
    the underlying `pip_compile` action is what the wrapper invokes).
    Contributors never invoke this target directly — they edit
    pyproject.toml, run any `bazel ...` command (or any `just ...`
    recipe that fans out to Bazel), and commit the resulting
    lockfile diff.
  - `//python:requirements_test` (auto-created by pip_compile) fails
    CI if the lockfile drifts; treat it as a backstop, not as a
    routine refresh trigger.

`pip_compile` uses `--all-extras`, so every optional-deps group in
pyproject.toml is automatically in the lockfile. BUILD files reach
deps via `all_requirements` (no enumeration).
"""

load("@rules_uv//uv:pip.bzl", "pip_compile")

package(default_visibility = ["//visibility:public"])

pip_compile(
    name = "requirements",
    requirements_in = "pyproject.toml",
    requirements_txt = "requirements.lock.txt",
    extra_args = ["--all-extras"],
    universal = True,
    # `:requirements_test` (auto-created by pip_compile) is tagged
    # `manual` so it doesn't gate CI's `bazel test //...`. Reason: uv
    # 0.5.18 with `--universal` is host-OS-dependent in subtle ways
    # (macOS uv resolves `audioop-lts` as unconditional; Linux uv
    # resolves it as `python_full_version >= '3.13'`-conditional, etc.).
    # Until we bump uv to a version with deterministic --universal
    # output, contributors regen the lockfile manually via
    # `bazel run //python:requirements`. The lockfile committed today
    # is generated on macOS; Linux regens diverge and would otherwise
    # ping-pong the drift test.
    tags = ["manual"],
)

filegroup(
    name = "project_metadata",
    srcs = [
        "pyproject.toml",
        "pytest.ini",
    ],
)

exports_files([
    "pyproject.toml",
    "pytest.ini",
    "requirements.lock.txt",
])
