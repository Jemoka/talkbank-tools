"""Bazel-managed Python wire types for the batchalign worker boundary.

`_proto_generated.py` is the autogenerated bag of pydantic-v2 BaseModels
(one per Rust proto type). It is **not** checked into source — the
`:_proto_generated_py` genrule emits it on every Bazel build that depends
on it. The sibling `proto.py` shim re-exports the generated names and
contributes the hand-written `rebuild_tagged_inputs` /
`serialize_tagged_outputs` rehydration helpers.

Data flow:

    crates/batchalign/batchalign-core/src/proto/*.rs   (hand-edited)
        │
        ▼
    //crates/batchalign/batchalign-core:emit_proto_schema   (rust_binary)
        │
        ▼
    //crates/batchalign/batchalign-core:proto_schema_json   (genrule)
        │
        ▼
    //bazel/python:codegen_proto_bin                        (py_binary)
        │  (datamodel-code-generator + post-processing)
        ▼
    :_proto_generated_py                                    (genrule, this file)

Both the Bazel `py_library` (//python/batchalign:batchalign_lib) and the
maturin wheel build (//python/batchalign:wheel via maturin_build.sh)
consume `:_proto_generated_py` directly — there is no manual `gen-proto`
step, and developers never run codegen by hand. Any change to the Rust
proto files is picked up by the next `bazel build`/`bazel test` /
`bazel run //python/batchalign:wheel`.
"""

load("@aspect_rules_py//py:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Emit `_proto_generated.py` from the unified JSON Schema. The codegen
# tool is a Bazel-built py_binary that wraps datamodel-code-generator;
# post-processing (Base64Str → Base64Bytes; drop dead Model class) lives
# in `bazel/python/codegen_proto.py`. The output lands at
# `bazel-bin/python/batchalign/_core/_proto_generated.py` which the
# sibling py_library imports as `batchalign._core._proto_generated`.
genrule(
    name = "_proto_generated_py",
    srcs = ["//crates/batchalign/batchalign-core:proto_schema_json"],
    outs = ["_proto_generated.py"],
    cmd = "$(execpath //bazel/python:codegen_proto_bin) $(execpath //crates/batchalign/batchalign-core:proto_schema_json) $@",
    tools = ["//bazel/python:codegen_proto_bin"],
)

# Rehome the engine cdylib into this package's path so the runfiles
# layout matches `from batchalign._core import _core`. Without this,
# the .so would land at `crates/batchalign/batchalign-engine/_core.so`
# in runfiles, never at `python/batchalign/_core/_core.so` where the
# Python import machinery looks. Moved here from
# `//python/batchalign:staged_core_so` after `_core/` became a Bazel
# subpackage (subpackages own their `outs` paths).
genrule(
    name = "staged_core_so",
    srcs = ["//crates/batchalign/batchalign-engine:_core_so"],
    outs = ["_core.so"],
    cmd = "cp $(SRCS) $@",
    output_to_bindir = True,
)

# `_core` package python sources. The parent py_library
# `//python/batchalign:batchalign_lib` does `glob(["**/*.py"])` which
# would normally pick these up, except that this directory is now a
# Bazel subpackage — glob stops at the subpackage boundary. Owning the
# srcs here and letting the parent depend on `:proto` is the canonical
# fix.
py_library(
    name = "proto",
    srcs = [
        "__init__.py",
        "proto.py",
        ":_proto_generated_py",
    ],
    # `imports = ["../.."]` puts `python/` on PYTHONPATH so the package
    # resolves as `batchalign._core.proto` rather than just `proto`.
    imports = ["../.."],
    data = [":staged_core_so"],
)
