"""Bazel-native dev / test path for the batchalign Python package.

Runtime targets (no maturin, no uv at `bazel run` time):

    bazel run  //python/batchalign            # CLI (py_binary)
    bazel test //python/batchalign:tests      # pytest (py_test)
    bazel build //python/batchalign           # py_binary + .so + py_library

The cdylib is built natively by `rust_shared_library` in
`//crates/batchalign/batchalign-engine` and lands at `_core.so`
alongside the Python sources in the runfiles tree.

Release-only (still maturin — sole reader of pyproject.toml's full
multi-platform tagging matrix + optional-deps groups):

    bazel run //python/batchalign:wheel       # maturin build
    bazel run //python/batchalign:publish     # twine upload

`pyproject.toml` is the single source of truth for the wheel
(version, runtime deps, all `[project.optional-dependencies]`
groups, scripts, classifiers).
"""

# Zero hand-listed deps. `all_runtime_deps()` returns every package in
# requirements.lock.txt, with rules_python's marker-conditional dangling
# names filtered out (see `//bazel/python:deps.bzl` for the why; the
# filter is a per-name list of *marker-excluded names from
# requirements.lock.txt*, not a list of deps to include).
load("//bazel/python:deps.bzl", "all_runtime_deps")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

_RUNTIME_DEPS = all_runtime_deps()

py_library(
    name = "batchalign_lib",
    # `_core/` is a Bazel subpackage (it owns the proto-codegen genrule),
    # so glob stops there. We pull the `_core` sources back in by
    # depending on its `:proto` py_library, which exports
    # `batchalign._core.{__init__,proto,_proto_generated}` plus the
    # staged `_core.so`.
    srcs = glob(
        ["**/*.py"],
        exclude = ["tests/**"],
    ),
    # Non-Python data shipped with backends (e.g. BA2's disfluency /
    # replacement word-lists `backends/utseg/support/*.eng` that the
    # CHATUtterance segmenter reads at runtime). Without these in runfiles
    # the lists load empty and `uh` never becomes `&-uh`.
    data = glob(["**/support/*"]),
    # `imports = [".."]` puts python/ on PYTHONPATH so `import batchalign`
    # resolves. The package layout is python/batchalign/{__init__,...}.py.
    imports = [".."],
    deps = _RUNTIME_DEPS + ["//python/batchalign/_core:proto"],
)

# Default runnable target — `bazel run //python/batchalign` invokes
# `python -m batchalign` against the Bazel-built `.so`. Some pypi
# packages overlap on benign data paths (e.g. `docs/index.rst`);
# `package_collisions = "warning"` lets the venv build finish with a
# warning instead of erroring on the duplicate file.
py_binary(
    name = "batchalign",
    srcs = ["__main__.py"],
    main = "__main__.py",
    # Many pypi packages ship overlapping benign `docs/` / `tests/`
    # paths that aspect's venv-builder flags as conflicts; suppress
    # entirely since none are runtime-load-relevant.
    package_collisions = "ignore",
    deps = [":batchalign_lib"],
)

py_test(
    name = "pytest",
    srcs = glob(["tests/**/*.py"]) + ["_pytest_runner.py"],
    main = "_pytest_runner.py",
    args = ["python/batchalign/tests", "-q"],
    # Same package-collision tolerance as `:batchalign` — heavy ML extras
    # ship overlapping benign data paths (e.g. `audmath/docs/index.rst`).
    # Many pypi packages ship overlapping benign `docs/` / `tests/`
    # paths that aspect's venv-builder flags as conflicts; suppress
    # entirely since none are runtime-load-relevant.
    package_collisions = "ignore",
    # all_requirements already contains pytest + pytest-xdist via the
    # dev extra in pyproject; don't re-list them or Bazel errors on
    # duplicate-deps.
    deps = [":batchalign_lib"] + _RUNTIME_DEPS,
)

# ---------------------------------------------------------------------------
# Maturin-driven wheel + publish (release path only).
# ---------------------------------------------------------------------------
# Hermetic C toolchain injected into both maturin escape paths. The
# toolchains_llvm-managed clang + ar + ranlib are passed as runfiles
# rootpaths; the shell scripts resolve them via $RUNFILES_DIR and export
# CC/CXX/AR/RANLIB before invoking maturin. cc-rs inside cargo then
# picks up the pinned compiler instead of /usr/bin/cc, which decouples
# every `*-sys` crate build from the host CommandLineTools state. See
# MODULE.bazel's `toolchains_llvm` block for the cflag injection that
# papers over the macOS 26.x SDK `__kernel_ptr_semantics` regression.
_LLVM_TOOLS = [
    "@llvm_toolchain_llvm//:bin/clang",
    "@llvm_toolchain_llvm//:bin/llvm-ar",
    "@llvm_toolchain_llvm//:bin/llvm-ranlib",
]

_WHEEL_DATA = [
    "//bazel/python:hermeticity_guard.sh",
    "//bazel/python:runfiles_resolve.sh",
    "//crates/batchalign/batchalign-engine:_core",
    "//crates/batchalign/batchalign-core:batchalign_core",
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/core/talkbank-transform:talkbank_transform",
    "//python:pyproject.toml",
    # The autogenerated proto module is staged into the source tree by
    # `maturin_build.sh` before maturin packages — wheels MUST ship a
    # current copy.
    "//python/batchalign/_core:_proto_generated_py",
] + _LLVM_TOOLS

# `$(COMPILATION_MODE)` is a Bazel make-variable that expands to `opt`,
# `dbg`, or `fastbuild` based on `-c <mode>` at run time. The shell
# scripts translate that into maturin's `--release` / dev profile, so
# users never need PYAPP_PROFILE / MATURIN_PROFILE env vars -- `bazel run
# -c opt //...` is the only knob.
sh_binary(
    name = "wheel",
    srcs = ["//bazel/python:maturin_build.sh"],
    args = [
        "$(rootpath @multitool//tools/uv)",
        "$(rootpath //python/batchalign/_core:_proto_generated_py)",
        "$(COMPILATION_MODE)",
        "$(rootpath @llvm_toolchain_llvm//:bin/clang)",
        "$(rootpath @llvm_toolchain_llvm//:bin/llvm-ar)",
        "$(rootpath @llvm_toolchain_llvm//:bin/llvm-ranlib)",
    ],
    data = ["@multitool//tools/uv"] + _WHEEL_DATA,
)

# Standalone production-daemon sidecar binary built via PyApp.
#
# `bazel run //python/batchalign:sidecar` produces a self-contained
# executable at `python/target/pyapp/bin/sidecar` that bundles
# CPython + the batchalign wheel + the `[api]` extra. The binary IS
# the daemon — running it boots `batchalign3 daemon` directly without
# the user typing the subcommand. Named "sidecar" because that's the
# role it plays in a deployment (companion service next to the main
# CLI / wheel install, not a separate top-level app).
#
# Follows the same shell-out pattern as :wheel — the build needs the
# host cargo + maturin and cannot live inside Bazel's hermetic sandbox.
# Hermeticity is policed by `hermeticity_guard.sh` (uv/maturin/python/
# rustc pins) + the explicit pyapp version pin in pyproject.toml.
sh_binary(
    name = "sidecar",
    srcs = ["//bazel/python:pyapp_build.sh"],
    args = [
        "$(rootpath @multitool//tools/uv)",
        "$(rootpath //python/batchalign/_core:_proto_generated_py)",
        "$(COMPILATION_MODE)",
        "$(rootpath @llvm_toolchain_llvm//:bin/clang)",
        "$(rootpath @llvm_toolchain_llvm//:bin/llvm-ar)",
        "$(rootpath @llvm_toolchain_llvm//:bin/llvm-ranlib)",
    ],
    data = ["@multitool//tools/uv"] + _WHEEL_DATA,
)

# Bazel-tracked sidecar binary, produced by the same pyapp_build.sh
# the :sidecar sh_binary runs. Downstream Bazel consumers (e.g. the
# Tauri-bundled desktop GUI at //apps/batchalign/batchalign-gui/) get a
# proper file artifact addressable via $(rootpath ...) / rlocation
# instead of having to invoke an sh_binary or escape-path-hunt for the
# output.
#
# `local = True` is required: pyapp_build.sh shells out to host cargo
# + maturin (sole reader of pyproject.toml's multi-platform tagging
# matrix), neither of which lives in Bazel's hermetic sandbox.
# pyapp_genrule.sh wraps the script for the genrule context: it
# self-locates the workspace via realpath-of-BASH_SOURCE walk-up so
# BUILD_WORKSPACE_DIRECTORY is available, runs the build, and copies
# the produced binary into $@.
#
# `srcs` is intentionally broad — any wheel-input change should
# trigger a rebuild. The actual cargo + maturin caches under python/
# target/ survive across rebuilds (they're escape-path), so the cold
# cost is only paid once per dep change.
genrule(
    name = "sidecar_bin",
    outs = ["sidecar.bin"],
    # Mirror _WHEEL_DATA (covers the Rust workspace crates + proto module
    # + pyproject.toml) plus all batchalign Python sources. Any change
    # under these triggers a rebuild via Bazel's normal incremental
    # tracking. The actual maturin / cargo caches survive between
    # rebuilds because they're under python/target/ in the workspace
    # (an escape path the genrule's cmd writes to via the wrapper).
    srcs = _WHEEL_DATA + glob(
        ["**/*.py"],
        exclude = ["tests/**", "_core/_proto_generated.py"],
    ),
    tools = [
        "//bazel/python:pyapp_build.sh",
        "//bazel/python:pyapp_genrule.sh",
        "//bazel/python:hermeticity_guard.sh",
        "//bazel/python:runfiles_resolve.sh",
        "@multitool//tools/uv",
        # Hermetic cargo + rustc via rules_rust's host-platform-
        # selecting current_* filegroups. pyapp_genrule.sh prepends
        # their dir to PATH so the inner pyapp_build.sh's `cargo
        # install pyapp` and `uv run maturin build` (maturin shells to
        # cargo) use Bazel's toolchain — NOT whatever the host happens
        # to have installed. The rustc version pin in pyproject.toml
        # [tool.batchalign.pinned_tools] must match MODULE.bazel
        # rust.toolchain(versions = [...]).
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ] + _LLVM_TOOLS,
    cmd = " ".join([
        # Hermeticity status (what this genrule does NOT touch host
        # state for):
        #   uv         → @multitool//tools/uv                  ✓
        #   rustc/cargo→ @rules_rust//rust/toolchain (PATH-injected)  ✓
        #   maturin    → uv run, version pinned in pyproject.toml  ✓
        #   python     → uv-managed venv, version pinned             ✓
        #   clang (lin/win) → @llvm_toolchain_llvm              ✓
        #   clang (macOS)   → xcrun (host Xcode) — see              ✗
        #                     bazel/python/pyapp_build.sh L70-100.
        #                     Hermetic LLVM 17.0.6 can't parse Xcode
        #                     26.x SDK headers (__kernel_ptr_semantics
        #                     etc.). Apple ships SDK + clang as a
        #                     matched pair; we'd need a hermetic macOS
        #                     SDK to close this gap. macOS users still
        #                     need Xcode CLI Tools installed.
        #
        # PYAPP_RUST_BIN_DIRS: space-separated execpaths of cargo +
        # rustc from rules_rust's host-platform-selecting filegroups.
        # The wrapper extracts dirname(cargo) and prepends to PATH so
        # the inner maturin/cargo invocations use Bazel's rust toolchain.
        "PYAPP_RUST_BIN_DIRS='$(execpaths @rules_rust//rust/toolchain:current_cargo_files) $(execpaths @rules_rust//rust/toolchain:current_rustc_files)'",
        "$(execpath //bazel/python:pyapp_genrule.sh)",
        "$@",
        "$(execpath @multitool//tools/uv)",
        "$(execpath //python/batchalign/_core:_proto_generated_py)",
        "$(COMPILATION_MODE)",
        "$(execpath @llvm_toolchain_llvm//:bin/clang)",
        "$(execpath @llvm_toolchain_llvm//:bin/llvm-ar)",
        "$(execpath @llvm_toolchain_llvm//:bin/llvm-ranlib)",
    ]),
    local = True,
)

sh_binary(
    name = "publish",
    srcs = ["//bazel/python:twine_upload.sh"],
    args = ["$(rootpath @multitool//tools/uv)"],
    data = [
        "@multitool//tools/uv",
        "//bazel/python:hermeticity_guard.sh",
        "//python:pyproject.toml",
    ],
)

# Lint kept as a shell-out because mypy/ruff configs sit in the uv-managed
# venv. Could become a py_test rule later; for now sh_binary is enough.
sh_binary(
    name = "lint",
    srcs = ["//bazel/python:lint.sh"],
    args = ["$(rootpath @multitool//tools/uv)"],
    data = [
        "@multitool//tools/uv",
        "//bazel/python:hermeticity_guard.sh",
        "//python:pyproject.toml",
    ],
)
