"""Bazel-native dev / test path for the batchalign Python package.

Runtime targets (no maturin, no uv at `bazel run` time):

    bazel run  //python/batchalign            # CLI (py_binary)
    bazel test //python/batchalign:tests      # pytest (py_test)
    bazel build //python/batchalign           # py_binary + .so + py_library

The cdylib is built natively by `rust_shared_library` in
`//crates/batchalign/batchalign-engine` and lands at `_core.so`
alongside the Python sources in the runfiles tree.

Release-only (still maturin — sole reader of pyproject.toml's full
multi-platform tagging matrix + optional-deps groups):

    bazel run //python/batchalign:wheel       # maturin build
    bazel run //python/batchalign:publish     # twine upload

`pyproject.toml` is the single source of truth for the wheel
(version, runtime deps, all `[project.optional-dependencies]`
groups, scripts, classifiers).
"""

load("@pypi//:requirements.bzl", "requirement")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# Direct top-level imports only. Optional backends (whisper, pyannote,
# revai, etc.) load lazily inside their backend module — wheel
# consumers get them via `pip install batchalign[<extra>]`. Adding a
# new dep here = adding it to pyproject.toml first then re-locking;
# `requirement()` handles platform markers correctly (unlike a naive
# `all_requirements` wildcard which lists platform-conditional names
# whose BUILD files pip.parse didn't generate).
_RUNTIME_DEPS = [
    requirement(n)
    for n in (
        "numpy",
        "polars",
        "soundfile",
        "stanza",
        "tqdm",
        "transformers",
        "typer",
    )
]

py_library(
    name = "batchalign_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["tests/**"],
    ),
    # `imports = [".."]` puts python/ on PYTHONPATH so `import batchalign`
    # resolves. The package layout is python/batchalign/{__init__,...}.py.
    imports = [".."],
    # The cdylib must land at `python/batchalign/_core/_core.so` in the
    # runfiles tree — matching what maturin produces and what
    # `batchalign/_core/__init__.py` imports as `_core._core`. The
    # `:staged_core_so` genrule below re-routes the engine output.
    data = [":staged_core_so"],
    deps = _RUNTIME_DEPS,
)

# Rehome the engine cdylib into this package's path so the runfiles
# layout matches `from batchalign._core import _core`. Without this,
# the .so would land at `crates/batchalign/batchalign-engine/_core.so`
# in runfiles, never at `python/batchalign/_core/_core.so` where the
# Python import machinery looks.
genrule(
    name = "staged_core_so",
    srcs = ["//crates/batchalign/batchalign-engine:_core_so"],
    outs = ["_core/_core.so"],
    cmd = "cp $(SRCS) $@",
    output_to_bindir = True,
)

# Default runnable target — `bazel run //python/batchalign` invokes
# `python -m batchalign` against the Bazel-built `.so`.
py_binary(
    name = "batchalign",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [":batchalign_lib"],
)

py_test(
    name = "pytest",
    srcs = glob(["tests/**/*.py"]) + ["_pytest_runner.py"],
    main = "_pytest_runner.py",
    args = ["python/batchalign/tests", "-q"],
    # all_requirements already contains pytest + pytest-xdist via the
    # dev extra in pyproject; don't re-list them or Bazel errors on
    # duplicate-deps.
    deps = [":batchalign_lib"] + _RUNTIME_DEPS,
)

# ---------------------------------------------------------------------------
# Maturin-driven wheel + publish (release path only).
# ---------------------------------------------------------------------------
_WHEEL_DATA = [
    "//bazel/python:hermeticity_guard.sh",
    "//crates/batchalign/batchalign-engine:_core",
    "//crates/batchalign/batchalign-core:batchalign_core",
    "//crates/core/talkbank-model:talkbank_model",
    "//crates/core/talkbank-parser:talkbank_parser",
    "//crates/core/talkbank-transform:talkbank_transform",
    "//python:pyproject.toml",
]

sh_binary(
    name = "wheel",
    srcs = ["//bazel/python:maturin_build.sh"],
    args = ["$(rootpath @multitool//tools/uv)"],
    data = ["@multitool//tools/uv"] + _WHEEL_DATA,
)

sh_binary(
    name = "publish",
    srcs = ["//bazel/python:twine_upload.sh"],
    args = ["$(rootpath @multitool//tools/uv)"],
    data = [
        "@multitool//tools/uv",
        "//bazel/python:hermeticity_guard.sh",
        "//python:pyproject.toml",
    ],
)

# Lint kept as a shell-out because mypy/ruff configs sit in the uv-managed
# venv. Could become a py_test rule later; for now sh_binary is enough.
sh_binary(
    name = "lint",
    srcs = ["//bazel/python:lint.sh"],
    args = ["$(rootpath @multitool//tools/uv)"],
    data = [
        "@multitool//tools/uv",
        "//bazel/python:hermeticity_guard.sh",
        "//python:pyproject.toml",
    ],
)
