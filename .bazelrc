# =============================================================================
# Bazel configuration for talkbank-tools
# =============================================================================
# Lockfile reactivity: `tools/bazel` (a Bazelisk wrapper) detects stale
# `Cargo.lock` / `python/requirements.lock.txt` against their source
# manifests on every `bazel ...` invocation and triggers a refresh
# inline. Contributors never need to remember a separate "repin" /
# "relock" command; editing a manifest and rerunning Bazel is the whole
# workflow. The escape hatch `TALKBANK_BAZEL_SKIP_RESOLVE=1` skips the
# auto-refresh when iterating on the wrapper itself.
#
# Maturin remains the source of truth for the PyO3 wheel; Bazel wraps
# it with `//python/batchalign:wheel`, which shells out to
# `maturin build`.

# ---- bzlmod (modern Bazel dependency resolution) ---------------------------
common --enable_bzlmod

# build status
build --workspace_status_command=bazel/stamp.sh

# build fast
build --compilation_mode=opt

# ---- Resource hygiene ------------------------------------------------------
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --disk_cache=~/.cache/bazel-talkbank-tools
build --experimental_remote_cache_compression
build --legacy_external_runfiles=false              # tighter sandbox
build --incompatible_strict_action_env              # reproducible env

# Bazel 8 default would error on `glob(["src/parser.h"])` when that
# file doesn't exist. Many BUILD files in this workspace glob over
# patterns that are conditionally present (generated artifacts,
# optional headers, deleted dashboards, etc.). Restoring Bazel 7
# behavior is cheaper than per-glob `allow_empty = True` everywhere.
common --noincompatible_disallow_empty_glob

# ---- Test ergonomics -------------------------------------------------------
test --test_output=errors                           # show output only on failure
test --test_summary=detailed
test --test_verbose_timeout_warnings
test --cache_test_results=auto

# ---- Rust (rules_rust) -----------------------------------------------------
# crate_universe consumes the workspace `Cargo.lock`. Staleness against
# `Cargo.toml` is repaired automatically by `tools/bazel`.
build --@rules_rust//rust/settings:experimental_use_cc_common_link=False

# CI builds set this to enable stricter clippy.
build:ci --@rules_rust//:clippy_flags=-Dwarnings

# ---- Python ----------------------------------------------------------------
# Use a hermetic Python toolchain. Maturin builds use the host toolchain
# because that's what produces shipping wheels.
build --@rules_python//python/config_settings:python_version=3.12

# ---- Platform-specific tweaks ---------------------------------------------
build:macos --macos_minimum_os=12.0                 # match release contract

# ---- Convenience configs ---------------------------------------------------
# `bazel build --config=release //...` for optimized binaries
build:release --compilation_mode=opt
build:release --strip=always
build:release --@rules_rust//rust/settings:codegen_units=1

# `bazel build --config=dev //...` for fast iteration
build:dev --compilation_mode=dbg
build:dev --@rules_rust//rust/settings:codegen_units=256

# `bazel build --config=ci` for the GitHub Actions matrix
build:ci --show_timestamps
build:ci --color=yes
build:ci --verbose_failures
test:ci --keep_going
test:ci --flaky_test_attempts=1                     # never silently retry in CI

# ---- User-local overrides --------------------------------------------------
# Place machine-specific tuning in `.bazelrc.user` (gitignored).
try-import %workspace%/.bazelrc.user
