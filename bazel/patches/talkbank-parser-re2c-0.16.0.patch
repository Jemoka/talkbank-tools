# Bazel's cargo_build_script runner does not execute with the crate root as its
# process cwd. Resolve the explicitly declared lexer through Cargo's manifest
# directory on every platform.
diff --git a/build.rs b/build.rs
--- a/build.rs
+++ b/build.rs
@@ -19,0 +20,2 @@
+    let manifest_dir = env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set by Cargo");
+    let vendored_lexer = Path::new(&manifest_dir).join(VENDORED_LEXER);
@@ -44 +46 @@
-    std::fs::copy(VENDORED_LEXER, &out_path)?;
+    std::fs::copy(vendored_lexer, &out_path)?;
