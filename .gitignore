# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Cargo local config (dev-only: disables sccache wrapper)
.cargo/config.toml

# Rust build artifacts
/target/
**/target/
**/*.rs.bk

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.venv/
.venv-*/
*.egg-info/
build/
dist/

# Node
node_modules/

# Logs
*.log

# Book build output
/book/build/

# Test artifacts
corpus/reference/*.actual
corpus/reference/*.diff
spec/tmp/

# Java Chatter per-directory error logs (regenerated on every run;
# not source — retained as tests/check-error-corpus/brian-bad/00errors.cex
# which is an intentional fixture, separately excluded)
corpus/reference/**/00errors.cex
corpus/reference-xml/**/00errors.cex

# Mutation testing
mutants.out/
mutants.out.old/

# Coverage
lcov*.info

# Stray symlinks
/talkbank-tools

# Serena MCP cache (per-repo language-server indexes)
.serena/

# Vendored Swift Package Manager checkouts (should never be committed)
**/.build/
**/.tmp-review-venv/
/bazel-*

# Compiled native extensions — built by maturin (host wheel) or
# Bazel's rust_shared_library (dev-loop cdylib); never source.
*.so
*.dylib
*.pyd
*.dll
# Maturin's editable install writes into python/batchalign/_core/
python/batchalign/_core/_core.*.so
python/batchalign/_core/_core.*.dylib
python/batchalign/_core/_core.*.pyd

# Bazel-generated proto wire types (autogen from
# crates/batchalign/batchalign-core/src/proto/*.rs via the schema emitter
# + bazel/python/codegen_proto.py). Materialized in the source tree only
# when maturin packages the wheel; otherwise Bazel py_library consumes the
# `bazel-bin/` copy directly. Never commit.
python/batchalign/_core/_proto_generated.py

# Coordination scratch (multi-agent talk doc; not source of truth)
talk.txt

# Playwright e2e outputs (batchalign-gui)
apps/batchalign/batchalign-gui/test-results/
apps/batchalign/batchalign-gui/playwright-report/
apps/batchalign/batchalign-gui/e2e-final.png
apps/batchalign/batchalign-gui/e2e-*.png

# Tauri-generated rollups (capabilities.json + acl-manifests.json +
# {desktop,macOS,windows}-schema.json). tauri-build regenerates these
# from src-tauri/capabilities/*.toml + the plugin deps on every cargo
# build, so checking them in just creates merge-conflict churn.
apps/batchalign/batchalign-gui/src-tauri/gen/
apps/chatter/chatter-gui/src-tauri/gen/
