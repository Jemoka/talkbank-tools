# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Cargo local config (dev-only: disables sccache wrapper)
.cargo/config.toml

# Rust build artifacts
/target/
**/target/
**/*.rs.bk

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.venv/
.venv-*/
*.egg-info/
build/
dist/

# Node
node_modules/

# Logs
*.log

# Book build output
/book/build/

# Test artifacts
corpus/reference/*.actual
corpus/reference/*.diff
spec/tmp/

# Java Chatter per-directory error logs (regenerated on every run;
# not source — retained as tests/check-error-corpus/brian-bad/00errors.cex
# which is an intentional fixture, separately excluded)
corpus/reference/**/00errors.cex
corpus/reference-xml/**/00errors.cex

# Mutation testing
mutants.out/
mutants.out.old/

# Coverage
lcov*.info

# Stray symlinks
/talkbank-tools

# Serena MCP cache (per-repo language-server indexes)
.serena/

# Vendored Swift Package Manager checkouts (should never be committed)
**/.build/
**/.tmp-review-venv/
/bazel-*

# Compiled native extensions — built by maturin (host wheel) or
# Bazel's rust_shared_library (dev-loop cdylib); never source.
*.so
*.dylib
*.pyd
*.dll
# Maturin's editable install writes into python/batchalign/_core/
python/batchalign/_core/_core.*.so
python/batchalign/_core/_core.*.dylib
python/batchalign/_core/_core.*.pyd

# Coordination scratch (multi-agent talk doc; not source of truth)
talk.txt
